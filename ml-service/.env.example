# ==============================================================================
# Environment Variables — Norway SmartLife FastAPI ML & AI Backend (Render)
# ==============================================================================
# Copy this file to .env for local testing. In Render, set these in Environment tab.
# NEVER commit real secret values to source control.

# Server Port (Render sets this automatically at runtime)
PORT=8000

# CORS Allowed Origins (Comma-separated list of origins permitted to call this service)
# Example for production: https://norway-smartlife.vercel.app,http://localhost:5173
CORS_ORIGINS=https://norway-smartlife.vercel.app,http://localhost:5173,http://localhost:3000

# Supabase Database & Service Role Connection (for prediction logging & trip syncing)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API Key (for NLP itinerary extraction)
GEMINI_API_KEY=your_gemini_api_key_here
