# ==============================================================================
# Norway SmartLife - Frontend Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local with production credentials to version control.
# ==============================================================================

# ── Render Backend & ML Service ──────────────────────────────────────────────
# URL of your Render deployed FastAPI ML Service
# Local: http://localhost:8000
# Production: https://norway-smartlife-ml.onrender.com
VITE_API_URL=https://norway-smartlife-ml.onrender.com

# ── Supabase Backend ─────────────────────────────────────────────────────────
# URL and anonymous public key for connecting to Supabase database & auth
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Payment Gateway (Razorpay Client) ─────────────────────────────────────────
# Public client Key ID for payment modal initialization (Safe for client)
# Private secret RAZORPAY_KEY_SECRET is strictly stored on backend Edge Functions
# Use rzp_test_* for development, rzp_live_* for production
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# ── AI Travel Assistant & Gemini AI ──────────────────────────────────────────
# All AI operations (Gemini API) are securely routed through Supabase Edge
# Functions. GEMINI_API_KEY is configured exclusively in Edge Function secrets
# and is never exposed to the frontend client.

# ── Interactive Maps (Leaflet + OpenStreetMap) ──────────────────────────────
# Powered by Leaflet + OpenStreetMap (CartoDB Dark Matter)
# Zero API keys, zero billing configuration, and privacy-preserving.
