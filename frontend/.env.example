# ==============================================================================
# Norway SmartLife - Frontend Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local with production credentials to version control.
# ==============================================================================

# ── Render Backend & ML Service ──────────────────────────────────────────────
# URL of your Render deployed FastAPI ML Service
# Local: http://localhost:8000
# Production: https://norway-smartlife-ml.onrender.com
VITE_API_URL=https://norway-smartlife-ml.onrender.com

# ── Supabase Backend ─────────────────────────────────────────────────────────
# URL and anonymous key for connecting to Supabase database & auth
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Payment Gateway (Razorpay) ───────────────────────────────────────────────
# Public client Key ID for payment modal initialization
# Use rzp_test_* for development, rzp_live_* for production
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# ── AI Travel Assistant (Google Gemini) ──────────────────────────────────────
# API Key for client-side / edge AI planning assistance
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Maps & Location Services ──────────────────────────────────────────
# Public API key for embedded maps, directions, and place lookups
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

